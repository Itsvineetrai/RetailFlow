# AeroMart Data Platform
# Environment Configuration

# Project
PROJECT_NAME=AeroMart-DataPlatform
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=UTC

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_ONLINE_SALES=online-sales
KAFKA_TOPIC_DLQ=dead-letter-queue

# Spark
SPARK_MASTER=spark://spark-master:7077
SPARK_APP_NAME=AeroMartPipeline
SPARK_CHECKPOINT_DIR=storage/checkpoints

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RAW=raw-pos-files
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# Storage
STORAGE_PATH=storage

# Currency
BASE_CURRENCY=USD

# Generator
TRANSACTIONS_PER_SECOND=100
POS_BATCH_INTERVAL_MINUTES=60

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000